{
  "name": "habitual-app",
  "version": "1.0.0",
  "description": "Habitual App with Firebase",
  "scripts": {
    "build-frontend": "cd frontend-src && npm run build",
    "copy-to-public": "xcopy frontend-src\\dist\\* public\\ /E /I /Y",
    "build": "npm run build-frontend && npm run copy-to-public",
    "deploy": "npm run build && firebase deploy",
    "emulators": "firebase emulators:start"
  }
}